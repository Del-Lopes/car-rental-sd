# Carental :: variaveis de ambiente
# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). O .env.local nunca vai para o git.

# URL do projeto: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave publica (anon). Pode aparecer no browser: quem protege os dados e a RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publica do site, usada nos links de confirmacao de e-mail.
# Em producao: https://www.carental.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRETA. Ignora toda a RLS -- usada apenas por scripts administrativos
# (npm run create-admin). Nunca prefixe com NEXT_PUBLIC_ e nunca use no browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# E-mail (contrato assinado) via Brevo -- gratis ate 300/dia, sem dominio e sem
# verificacao em 2 etapas. Na Vercel: variaveis secretas, sem NEXT_PUBLIC_.
# Brevo > Settings > SMTP & API > aba SMTP: copie o "Login" e gere uma SMTP key.
# Sem estas variaveis o contrato e assinado normalmente; so o e-mail nao sai.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# O "Login" do SMTP do Brevo (algo como 9a1b2c001@smtp-brevo.com)
SMTP_USER=
# A SMTP key gerada no Brevo (comeca com xsmtpsib-)
SMTP_PASS=
# Remetente verificado no Brevo (Senders & IP). Recebe respostas e copia dos contratos.
MAIL_FROM_ADDRESS=carentaldev@gmail.com
MAIL_FROM_NAME=Carental

# SECRETA. Connection string do banco (Dashboard > Connect > Session pooler),
# usada para aplicar migrations sem login no CLI: npm run db:push:url
SUPABASE_DB_URL=
